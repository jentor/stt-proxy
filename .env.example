# ---- HTTP server ----------------------------------------------------------
# Address the proxy binds to. Default 0.0.0.0:8000
HOST=0.0.0.0
PORT=8000

# Logging level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ---- Provider credentials --------------------------------------------------
# Set ONLY the providers you want to enable. Leave both groups blank and the
# proxy will refuse to start.

# --- Yandex SpeechKit (STT v3) ---
# Both must be set together to enable the Yandex provider.
# Get them in the Yandex Cloud console: https://console.yandex.cloud/
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Yandex model tag (general, general:rc, general:deprecated, deferred-general, ...)
YANDEX_MODEL=general

# --- SaluteSpeech ---
# The single base64 of `client_id:client_secret` issued by SaluteSpeech Studio.
# Generate it at https://developers.sber.ru/docs/ru/salutespeech/quick-start
# The SDK also reads SBER_SPEECH_API_KEY directly; SBER_SALUTE_SPEECH_API_KEY
# takes precedence when both are set.
SBER_SALUTE_SPEECH_API_KEY=
SBER_SPEECH_API_KEY=

# ---- Routing --------------------------------------------------------------
# When both providers are configured, requests must use a prefixed `model`
# (yandex-* or salute-*) OR you set the default provider here.
# STT_DEFAULT_PROVIDER=yandex
# STT_DEFAULT_PROVIDER=salute

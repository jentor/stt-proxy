# ---- HTTP server ----------------------------------------------------------
# All settings are namespaced STT_PROXY_*. See README "Configuration" section.

STT_PROXY_HOST=127.0.0.1
STT_PROXY_PORT=8000
STT_PROXY_LOG_LEVEL=INFO
STT_PROXY_WORKERS=1
# Optional Bearer token for all API routes; omit to disable authentication.
# Must contain at least 32 characters when set.
# STT_PROXY_API_KEY=replace-with-at-least-32-random-characters

# ---- Provider credentials --------------------------------------------------
# The proxy refuses to start until both Yandex credentials are set.

# --- Yandex SpeechKit (STT v3) ---
# Both must be set together to enable the Yandex provider.
# Get them in the Yandex Cloud console: https://console.yandex.cloud/
STT_PROXY_YANDEX_API_KEY=
STT_PROXY_YANDEX_FOLDER_ID=
# Yandex model tag (general, general:rc, general:deprecated, deferred-general, ...)
STT_PROXY_YANDEX_MODEL=general
